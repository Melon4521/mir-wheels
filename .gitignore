# --- Конфиденциальные данные и настройки (ГЛАВНОЕ) ---
# Файлы окружения с паролями от базы данных и API-ключами
.env
.env.local
.env.*.local
config.local.php
config.secure.php
secrets.php

# --- Загрузки пользователей и медиа (чтобы не забивать Git) ---
# Папки, куда клиенты загружают аватары или файлы (подстройте под свой проект)
/uploads/
/media/products/
/images/catalog/
# Исключаем картинки, но оставляем саму структуру папок, если нужно
# !/uploads/.gitkeep

# --- Логи и временные файлы ---
*.log
/logs/
/tmp/
/cache/
*.cache

# --- Файлы зависимостей (если используете сборщики или пакеты) ---
node_modules/
/vendor/
package-lock.json
composer.lock

# --- Системные файлы операционных систем ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Настройки сред разработки и редакторов (IDE) ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
